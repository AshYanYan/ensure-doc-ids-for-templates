            {
                "paragraph": {
                    "string": "Dear {provider_prefix} {provider_full_name},",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "[patient_org.report.reportPlanDisplayName] is committed to enriching the lives of its patients by improving health outcomes and ensuring the judicious use of medication.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "We identified your patient, {patient_full_name}, as having potential therapeutic opportunities. Please review the statements on the attached list for possible courses of action.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "[patient_org.report.reportPlanDisplayName] preferred drug list (PDL) may be viewed at:<br/>[patient_org.report.reportFormularyLink|NA]",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "<b>Note</b>: The patient is currently enrolled in <b>[patient_org.report.reportPlanDisplayName]</b>.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "For any medication changes, the patient's pharmacy may be contacted:",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphText",
                        "spaceAfter": 0.0
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Pharmacy: <b>{pharmacy_name}</b>. Phone: <b>{pharmacy_phone}</b>.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Please contact me if you have any additional questions.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Thank you.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Sincerely,",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
