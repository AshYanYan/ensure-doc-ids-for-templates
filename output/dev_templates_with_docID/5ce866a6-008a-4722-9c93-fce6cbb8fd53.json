            },
            {
                "paragraph": {
                    "string": "If you want to talk about these documents, please call <i>[patient_org.report.reportPlanDisplayName] Healthy Living Program</i> at <i>the Healthline hotline at 1-866-339-2787 (TTY 711), Monday\u2013Friday, 8 a.m. to 8 p.m. Eastern.</i>",
                    "string_replacements": {
                        "default": {
                            "Spanish": "Si usted quiere hablar acerca de estos documentos adjuntos, por favor ll\u00e1me/nos <i>[patient_org.report.reportPlanDisplayName] Healthy Living Program</i> al l\u00ednea directa de <i>Healthline Hotline al 1-866-339-2787 (TTY 711), de lunes a viernes, de 8 a.m. a 8 p.m., hora del este. </i>"
                        }
                    },
                    "text_style": {
                        "parent_style": "ParagraphText"
