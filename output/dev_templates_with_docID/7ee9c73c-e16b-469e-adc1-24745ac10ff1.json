                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "list": {
                    "items": [
                        "Health Net Commercial Preferred Drug Lists (PDLs) may be viewed at www.healthnet.com/content/healthnet/en_us/providers/pharmacy.html.",
                        "The Medi-Cal Rx Contract Drug List may be viewed on the Medi-Cal Rx website at https://medi-calrx.dhcs.ca.gov/home/cdl. This information can also be found on our website at healthnet.com/content/healthnet/en_us/providers/pharmacy.html."
