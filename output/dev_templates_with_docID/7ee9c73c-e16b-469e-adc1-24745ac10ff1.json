                    }
                }
            },
            {
                "paragraph": {
                    "show_for": [
                        "centene:medicaid:calviva_health:health_net_medicaid_ca",
                        "centene:medicaid:community_health_plan_of_imperial_valley_chpiv:community_health_plan_of_imperial_valley"
                    ],
                    "string": "The Medi-Cal Rx Contract Drug List may be viewed on the Medi-Cal Rx website at https://medi-calrx.dhcs.ca.gov/home/cdl. This information can also be found on our website at healthnet.com/content/healthnet/en_us/providers/pharmacy.html.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "show_for": [
                        "centene:medicaid:calviva_health:health_net_medicaid_ca",
                        "centene:medicaid:community_health_plan_of_imperial_valley_chpiv:community_health_plan_of_imperial_valley"
                    ],
                    "string": "For any medication changes, the patient's pharmacy may be contacted:",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphText",
                        "spaceAfter": 0.0
                    }
                }
            },
            {
                "paragraph": {
                    "show_for": [
                        "centene:medicaid:calviva_health:health_net_medicaid_ca",
                        "centene:medicaid:community_health_plan_of_imperial_valley_chpiv:community_health_plan_of_imperial_valley"
                    ],
                    "string": "Pharmacy: <b>{pharmacy_name}</b>. Phone: <b>{pharmacy_phone}</b>.",
                    "text_style": {
                        "leading": 13.75,
                        "parent_style": "ParagraphMoreSpaceAfterText"
                    }
                }
            },
            {
                "paragraph": {
                    "show_for": [
                        "centene:medicaid:health_net:health_net_medicaid_ca"
                    ],
                    "string": "<b>Note</b>: The patient is currently enrolled in <b>[patient_org.report.reportPlanDisplayName]</b>.",
