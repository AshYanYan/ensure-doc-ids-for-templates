                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "display_conditions": [
                        "event_data_dmp_medications_opioid__display_name__dispense_prescriber__dispensed_date__last_6_months"
                    ],
                    "hide_conditions": [
                        "event_data_dmp_medications_benzo__display_name__dispense_prescriber__dispensed_date__last_6_months"
