                    }
                }
            },
            {
                "paragraph": {
                    "string": "If you have questions about this notice or our drug management program to help enrollees use prescription opioid medications safely, contact us at:",
                    "text_style": {
                        "parent_style": "ParagraphHeaderAndParagraphText"
                    }
                }
            },
