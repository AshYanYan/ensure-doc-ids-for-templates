            {
                "paragraph": {
                    "string": "[patient_org.report.reportPlanDisplayName], wants to help you get the most from your medicines.",
                    "string_replacements": {
                        "default": {
                            "Spanish": "[patient_org.report.reportPlanDisplayName] quiere que usted aproveche sus medicamentos al m\u00e1ximo."
