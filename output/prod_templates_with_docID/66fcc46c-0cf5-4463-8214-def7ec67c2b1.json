            {
                "paragraph": {
                    "string": "As part of your Excellus BlueCross BlueShield Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>This service is free to you and can help you save money.</b>",
                    "string_replacements": {
                        "aloha": {
                            "English": "Dear {patient_full_name},<br/><br/> As part of your <b>{hotline_name} </b>Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>There is no cost to participate.</b>"
                        },
                        "icare": {
                            "English": "Dear {patient_full_name},<br/><br/> As part of your <i>i</i>Care Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>There is no cost to participate.</b>"
                        },
                        "medigold": {
                            "English": "Dear ${patient_full_name}, <br/><br/> As part of your {hotline_name} Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>There is no cost to participate.</b>"
                        },
                        "priority_health": {
                            "English": "Dear {patient_full_name},<br/><br/> As part of your <b>Priority Health </b>Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>There is no cost to participate.</b>"
                        },
                        "simply_prescriptions": {
                            "English": "As part of your Simply Prescriptions Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>This service is free to you and can help you save money.</b>"
                        },
                        "univera": {
                            "English": "As part of your Univera Healthcare Medicare plan, we\u2019re pleased to welcome you into our Medication Therapy Management (MTM) program. Because you meet the program criteria based on the number of medications you take, the number of health conditions you have, and your annual prescription costs, you\u2019ve automatically qualified for this important program. <b>This service is free to you and can help you save money</b>"
                        }
                    },
