                        "fontSize": 12.0,
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "<b>What can MTM do for you?</b>",
                    "text_style": {
                        "fontSize": 13.0,
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "list": {
                    "items": [
                        "Address any concerns you have, such as side effects or drug interactions",
                        "Address any problems you have regarding accessing or affording your medications",
                        "Provide advice on how to get the most benefit from the drugs you take"
                    ],
                    "items_replacements": {
                        "icare": {
                            "English": [
                                "Address any questions or problems you have about your medications",
                                "Address any concerns you have, such as cost issues, side effects or drug interactions",
                                "Provide advice on how to get the most benefit from the drugs you take",
                                "Provide guidance on topics to discuss with your provider"
                            ]
                        },
