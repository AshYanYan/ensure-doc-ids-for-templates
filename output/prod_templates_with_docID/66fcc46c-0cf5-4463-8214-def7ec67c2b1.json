            },
            {
                "paragraph": {
                    "show_for": [
                        "priority_health"
                    ],
                    "string": "You won\u2019t need to switch pharmacies to participate in this program, and you can continue to use any Priority Health Medicare network pharmacy to fill your prescriptions.",
                    "text_style": {
                        "fontSize": 12.0,
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "<b>Want to participate? It\u2019s simple and helpful</b>",
                    "string_replacements": {
                        "aloha": {
                            "English": "<b>Want to participate? Get started now!</b>"
                        },
                        "icare": {
                            "English": "<b>Want to participate? Get started now!</b>"
                        },
                        "medigold": {
                            "English": "<b>Want to participate? Get started now!</b>"
                        },
                        "priority_health": {
