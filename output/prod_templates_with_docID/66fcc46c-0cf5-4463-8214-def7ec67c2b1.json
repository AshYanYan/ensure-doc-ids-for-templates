                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "list": {
                    "items": [
                        "Access to a pharmacist who will review all your prescription and over-the-counter medications",
                        "A To-Do-List that will help you get the best results from your medications",
                        "A Personal Medication List to keep track of the medications you\u2019re taking and why"
                    ],
                    "items_replacements": {
                        "icare": {
                            "English": [
                                "Access to a licensed pharmacist who will review all your prescription and over-the-counter medications",
