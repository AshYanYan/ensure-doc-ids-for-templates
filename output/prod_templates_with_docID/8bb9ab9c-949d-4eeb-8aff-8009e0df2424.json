                            "Chinese": "\u5982\u679c\u60a8\u60f3\u5546\u8a0e\u9019\u5169\u4efd\u6587\u4ef6\uff0c\u8acb\u81f4\u96fb{hotline_phone}\u8207 {hotline_name} \u806f\u7d61\uff0c{hotline_hours}\u3002"
