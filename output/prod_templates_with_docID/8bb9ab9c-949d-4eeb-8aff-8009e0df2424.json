            {
                "paragraph": {
                    "hide_condition": "report_text_wrapping_is_cjk",
                    "string": "If you want to talk about these documents, please call {hotline_name} at {hotline_phone}, {hotline_hours}.",
                    "string_replacements": {
                        "default": {
                            "Spanish": "Si usted quiere hablar acerca de estos documentos adjuntos, por favor llame al proveedor del MTM, al <b>{hotline_phone}</b> {hotline_hours}.",
                            "Vietnamese": "<font fontname='Arial-Unicode-normal'>N\u1ebfu qu\u00fd v\u1ecb mu\u1ed1n trao \u0111\u1ed5i v\u1ec1 nh\u1eefng t\u00e0i li\u1ec7u n\u00e0y, vui l\u00f2ng g\u1ecdi cho IEHP DualChoice \u1edf s\u1ed1 {hotline_phone}, {hotline_hours}.</font>"
