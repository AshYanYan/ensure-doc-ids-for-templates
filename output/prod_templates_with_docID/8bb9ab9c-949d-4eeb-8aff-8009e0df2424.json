            {
                "paragraph": {
                    "string": "Dear {patient_full_name},",
                    "string_replacements": {
                        "default": {
                            "Chinese": "\u89aa\u611b\u7684 {patient_full_name}",
                            "Spanish": "Saludo {patient_full_name},",
                            "Vietnamese": "<font fontname='Arial-Unicode-normal'>K\u00ednh g\u1eedi {patient_full_name},</font>"
                        }
                    },
