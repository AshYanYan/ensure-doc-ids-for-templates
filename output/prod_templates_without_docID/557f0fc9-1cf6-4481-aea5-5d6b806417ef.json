            {
                "paragraph": {
                    "spaceBefore": 20.0,
                    "string": "<b>Re: QUALITY IMPROVEMENT OPPORTUNITY</b>",
                    "text_style": {
                        "parent_style": "BiggerText"
                    }
                }
            },
            {
                "paragraph": {
                    "spaceBefore": 20.0,
                    "string": "Dear {provider_full_name},",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "SelectHealth is committed to providing quality and evidence-based pharmacy services to your patients. We have implemented a Quality Improvement Program to better support our providers in their efforts to deliver safe, appropriate, and cost-effective care to patients and members. This program uses drug-utilization algorithms with evidence-based guidelines to identify potential drug therapy concerns.",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "This letter has been generated because we have identified a member-specific quality opportunity. Please review the clinical information at the top of each page and the corresponding patient recommendation(s).",
                    "text_style": {
                        "parent_style": "CalloutText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "This program is meant to be informative. It is not intended to replace your authority, responsibility, or accountability for patient care.",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "A clinical pharmacist may contact you to discuss how the following information can be used to improve quality of care and reduce the risk of adverse events.",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Questions?",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "The following contact information may be used to request a personal consultation, provide feedback, ask questions, or request additional data. You can reach our Pharmacy Helpdesk team at the following numbers:",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Phone: 801-442-6354",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Fax: 385-297-2692",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Please note, all patients listed in this document have received a paid prescription with your national identification number (NPI), identifying you as the prescriber.",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "Sincerely,",
                    "text_style": {
                        "parent_style": "ParagraphText"
                    }
                }
            },
            {
                "paragraph": {
                    "string": "SelectHealth",
